{
  "schemaVersion": "1.0",
  "bundleName": "top.handwer.brewlibrary",
  "toolName": "previewInstall",
  "pluginType": "Device",
  "description": "预演安装软件包会带入哪些内容。token 为目录中存在的包名；返回 brew install --dry-run 的解析清单（wouldInstall 含依赖与版本、declaredCount、cmdline）。只读不动盘，不执行安装；需要网络，最长约两分钟。目录中不存在的包名返回 ERR_NOT_FOUND，不猜包名。",
  "arguments": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string",
        "description": "要预演安装的软件包名。"
      }
    },
    "required": ["token"]
  },
  "deviceCommand": {
    "template": {
      "header": {
        "namespace": "Common",
        "name": "ActionAndResult"
      },
      "payload": {
        "cardParam": {},
        "executeParam": {
          "executeMode": "foreground",
          "intentName": "previewInstall",
          "bundleName": "top.handwer.brewlibrary",
          "dimension": "",
          "needUnlock": true,
          "actionResponse": true,
          "timeOut": 180,
          "intentParam": {
            "token": "#{arguments.token}"
          },
          "achieveType": "INTENT"
        },
        "responses": [
          {
            "resultCode": "",
            "displayText": "",
            "ttsText": ""
          }
        ],
        "needUploadResult": true,
        "noHalfPage": false,
        "pageControlRelated": false
      }
    }
  }
}
