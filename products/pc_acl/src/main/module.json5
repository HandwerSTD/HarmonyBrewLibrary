{
  "module": {
    "name": "pc_acl",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "PcAbility",
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "routerMap": "$profile:router_map",
    "abilities": [
      {
        "name": "PcAbility",
        "srcEntry": "./ets/pcability/PcAbility.ets",
        "description": "$string:hmos_app_name",
        "icon": "$media:hmos_layered_image",
        "label": "$string:hmos_app_name",
        "startWindowIcon": "$media:ic_foreground",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "minWindowWidth": 1080,
        "minWindowHeight": 608,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ],
            "domainVerify": true
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "BrewFormAbility",
        "srcEntry": "./ets/sentinel/BrewFormAbility.ets",
        "label": "$string:sentinel_form_name",
        "description": "$string:sentinel_form_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "BrewWorkSchedulerExtension",
        "srcEntry": "./ets/sentinel/BrewWorkSchedulerExtension.ets",
        "label": "$string:sentinel_form_name",
        "description": "$string:sentinel_form_desc",
        "type": "workScheduler"
      }
    ],
    "skillProfiles": [
      {
        "name": "handwer-brew-library",
        "abilityName": "PcAbility",
        "srcEntries": [
          "../../skills/handwer-brew-library/scripts/BrewSkill.ets"
        ],
        "version": "1.1.0"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "PcAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:network_reason",
        "usedScene": {
          "abilities": [
            "PcAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrator_reason",
        "usedScene": {
          "abilities": [
            "PcAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_USER_FILE",
        "reason": "$string:read_write_user_file_reason",
        "usedScene": {
          "abilities": [
            "PcAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CUSTOM_SANDBOX",
        "reason": "$string:custom_sandbox_reason",
        "usedScene": {
          "abilities": [
            "PcAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}